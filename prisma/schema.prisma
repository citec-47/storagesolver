generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContainerSize {
  FT10
  FT20
  FT40
  FT45
  FT53
}

enum ContainerType {
  STANDARD
  HIGH_CUBE
  OPEN_TOP
  FLAT_RACK
  REEFER
  SIDE_DOOR
  OFFICE_MODIFIED
}

enum ContainerCondition {
  NEW
  ONE_TRIP
  CARGO_WORTHY
  WIND_WATER_TIGHT
  AS_IS
}

enum ProductStatus {
  ACTIVE
  DRAFT
  SOLD_OUT
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model Product {
  id                    String             @id @default(cuid())
  slug                  String             @unique
  title                 String
  size                  ContainerSize
  type                  ContainerType
  condition             ContainerCondition
  grade                 String?
  price                 Decimal            @db.Decimal(10, 2)
  salePrice             Decimal?           @db.Decimal(10, 2)
  stockQuantity         Int                @default(0)
  location              String
  description           String              @db.Text
  internalLength        String?
  internalWidth         String?
  internalHeight        String?
  externalLength       String?
  externalWidth        String?
  externalHeight       String?
  doorOpeningWidth     String?
  doorOpeningHeight    String?
  tareWeight            String?
  maxPayload            String?
  cubicCapacity         String?
  color                 String?
  features              String[]            @default([])
  featured              Boolean             @default(false)
  status                ProductStatus       @default(ACTIVE)
  images                ProductImage[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([size])
  @@index([condition])
  @@index([price])
  @@index([status])
  @@index([featured, status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  publicId  String
  alt       String
  width     Int?
  height    Int?
  blurData  String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Inquiry {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String
  company         String?
  deliveryAddress String?
  deliveryZip     String?
  message         String?       @db.Text
  items           Json
  status          InquiryStatus @default(NEW)
  internalNotes   String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}